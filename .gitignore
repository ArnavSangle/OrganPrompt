# LaTeX build artifacts (the .tex/.bib sources ARE tracked; the build is not).
# main.pdf is excluded deliberately: it is ~6MB and fully regenerable via
# scripts/build_paper.py, so committing it would bloat history on every revision.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/main.pdf
paper/sections/*.aux

# Overleaf staging dirs + zips are regenerated by scripts/build_overleaf.py
paper/overleaf_full/
paper/overleaf_short/
paper/figures_for_upload/
paper/*.zip
paper/*.pdf
paper/pdflatex*.fls
texput.log
